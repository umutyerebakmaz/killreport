{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pkill -9 -f 'next.*dev' 2>/dev/null || true && next dev --turbopack",
    "build": "pkill -9 -f 'next.*dev' 2>/dev/null || true && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "kill:port": "kill -9 $(ss -tlnp 2>/dev/null | grep :3000 | grep -oP 'pid=\\K[0-9]+') 2>/dev/null || pkill -9 -f 'next.*dev' || true",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "kill-node": "pkill -9 node",
    "remove:all": "rm -rf .next node_modules yarn.lock"
  },
  "dependencies": {
    "@apollo/client": "^3",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "graphql": "^16.11.0",
    "graphql-ws": "^6",
    "lottie-react": "^2.4.1",
    "next": "16.3.3",
    "postcss": "^8.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@tailwindcss/postcss": "^4.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.15",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
