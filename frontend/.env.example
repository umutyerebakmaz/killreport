# Copy this file to .env.local and adjust for your environment.
#
# Only NEXT_PUBLIC_* variables are readable in the browser. Never put secrets here —
# anything in this file is bundled into the client-side JavaScript.

# GraphQL endpoint for queries and mutations.
# The subscription WebSocket URL is derived from this value by swapping
# http:// -> ws:// and https:// -> wss://, so no separate variable is needed.
NEXT_PUBLIC_GRAPHQL_URL="http://localhost:4000/graphql"

# Backend origin, used by the EVE SSO callback page (src/app/auth/callback).
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# Public origin of this site, without a trailing slash. Share cards put absolute
# og:image URLs on it, so production must set it; it is inlined at build time,
# so set it before `next build`. Unset, it falls back to http://localhost:3000
# and a production build prints a warning.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
