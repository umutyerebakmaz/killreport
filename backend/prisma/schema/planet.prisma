model Planet {
  id              Int     @id @map("planet_id")
  name            String?
  solar_system_id Int
  type_id         Int?
  /// 1-based position in ESI's planets[] array.
  orbit_index     Int?
  position_x      Float?
  position_y      Float?
  position_z      Float?

  solar_system   SolarSystem    @relation(fields: [solar_system_id], references: [id], onDelete: Cascade)
  moons          Moon[]
  asteroid_belts AsteroidBelt[]

  /// Target of the composite FK: moons and asteroid_belts reference it through the
  /// (planet_id, solar_system_id) pair. Also serves as an index.
  @@unique([id, solar_system_id])
  /// planetsBySystem: WHERE solar_system_id IN (...) ORDER BY orbit_index, id.
  /// The counts query is served by this index's left prefix as well.
  @@index([solar_system_id, orbit_index, id])
  @@map("planets")
}
