model Planet {
  id              Int            @id @map("planet_id")
  name            String?
  solar_system_id Int
  type_id         Int?
  /// ESI'nın planets[] dizisindeki 1 tabanlı sıra.
  orbit_index     Int?
  position_x      Float?
  position_y      Float?
  position_z      Float?

  solar_system    SolarSystem    @relation("system_planets", fields: [solar_system_id], references: [id], onDelete: Cascade)
  moons           Moon[]
  asteroid_belts  AsteroidBelt[]

  @@index([solar_system_id])
  @@map("planets")
}
