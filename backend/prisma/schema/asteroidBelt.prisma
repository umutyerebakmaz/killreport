model AsteroidBelt {
  id              Int     @id @map("asteroid_belt_id")
  name            String?
  solar_system_id Int
  /// Zorunlu; Moon.planet_id ile aynı gerekçe.
  planet_id       Int
  orbit_index     Int?
  position_x      Float?
  position_y      Float?
  position_z      Float?

  solar_system SolarSystem @relation(fields: [solar_system_id], references: [id], onDelete: Cascade)
  /// Moon.planet ile aynı gerekçe: kuşağın sistemi, gezegeninin sistemiyle
  /// aynı olmak zorunda.
  planet       Planet      @relation(fields: [planet_id, solar_system_id], references: [id, solar_system_id], onDelete: Cascade)

  @@index([solar_system_id])
  @@index([planet_id, orbit_index, id])
  @@map("asteroid_belts")
}
