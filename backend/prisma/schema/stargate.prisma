model Stargate {
  id                      Int     @id @map("stargate_id")
  name                    String?
  solar_system_id         Int
  /// Step 2 leaves this empty; only worker-stargates fills it.
  destination_system_id   Int?
  destination_stargate_id Int?
  type_id                 Int?
  position_x              Float?
  position_y              Float?
  position_z              Float?

  solar_system       SolarSystem  @relation("StargateSystem", fields: [solar_system_id], references: [id], onDelete: Cascade)
  /// ON DELETE SET NULL, not Cascade: when a system is deleted, gates in OTHER
  /// systems that point at it must not be deleted, only have their target cleared.
  /// destination_stargate_id gets no FK: the same worker creates the target gate's
  /// row, so it would create an ordering dependency inside the queue that trips often.
  destination_system SolarSystem? @relation("StargateDestination", fields: [destination_system_id], references: [id], onDelete: SetNull)

  /// stargatesBySystem: WHERE solar_system_id IN (...) ORDER BY id.
  @@index([solar_system_id, id])
  /// No query filters on this today, but the new SET NULL FK requires it:
  /// without an index, deleting a system does a full scan of this table.
  @@index([destination_system_id])
  @@map("stargates")
}
