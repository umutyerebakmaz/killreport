model SolarSystem {
  id               Int            @id @map("system_id")
  name             String
  constellation_id Int?
  security_status  Float?
  security_class   String?
  star_id          Int?
  position_x       Float?
  position_y       Float?
  position_z       Float?
  /// CCP's schematic 2D map, from the SDE's mapSolarSystems.jsonl position2D.
  /// ESI does not serve it; `yarn sde:map-2d` fills it. position_2d_y is the
  /// map's z axis. Null for every wormhole, Abyssal and Proving system.
  position_2d_x    Float?
  position_2d_y    Float?
  constellation    Constellation? @relation(fields: [constellation_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  system_activity   SystemActivity[]
  star              Star?
  stargates         Stargate[]     @relation("StargateSystem")
  inbound_stargates Stargate[]     @relation("StargateDestination")
  planets           Planet[]
  moons             Moon[]
  asteroid_belts    AsteroidBelt[]
  stations          Station[]

  @@index([constellation_id])
  @@map("solar_systems")
}
