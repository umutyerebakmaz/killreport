[Unit]
Description=KillReport job: sovereignty campaigns
Wants=network-online.target rabbitmq-server.service redis-server.service
After=network-online.target rabbitmq-server.service redis-server.service
PartOf=killreport.target

[Service]
Type=oneshot
User=killreport
WorkingDirectory=/var/www/killreport/backend
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
Environment=USE_REDIS_PUBSUB=true
ExecStart=/usr/bin/yarn worker:sov:campaigns
KillSignal=SIGINT
SuccessExitStatus=130
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
